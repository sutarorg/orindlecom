# Copy to `.env.local` and fill in for a deployed build.
# Nothing here is required for the site to render — each value only switches on
# a feature, and every page works without it. Authentication in particular
# degrades honestly: with no Supabase credentials the auth screens render and
# validate, then say plainly that accounts aren't connected.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical origin used by metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://orindle.com

# ---------------------------------------------------------------------------
# Authentication (Supabase)
# ---------------------------------------------------------------------------

# Project URL and publishable key. The anon key is RLS-scoped and safe to ship.
# Without both of these, every auth operation returns `not_configured`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated providers that are ACTUALLY ENABLED in the Supabase dashboard.
# A social button is rendered only for providers listed here, because a button
# that always fails is worse than no button. Supported: google
NEXT_PUBLIC_AUTH_PROVIDERS=

# The service-role key is required by the server for the work RLS can never do:
# the Razorpay webhook (which has no user session), the cron jobs, rate-limit
# counters, and writing storage accounting rows. It bypasses RLS, so it must exist
# ONLY in the server environment — never in a NEXT_PUBLIC_ variable, never in a
# file in this repo. src/lib/supabase/service.ts is marked `server-only` so that
# importing it from a client component fails the build.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Contact form (Resend) — unrelated to auth
# ---------------------------------------------------------------------------

# Without the key the form still validates and returns an explicit "email
# delivery is not configured" notice pointing at the support address, rather
# than pretending the message was sent.
RESEND_API_KEY=
RESEND_FROM_ADDRESS="Orindle <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Dashboard storage (Cloudflare R2, via signed direct uploads)
# ---------------------------------------------------------------------------

# Server-only credentials for the R2 bucket that backs the personal dashboard.
# The browser never sees these: it receives short-lived presigned URLs from the
# server, uploads bytes straight to R2, and the server confirms afterwards.
#
# With none of these set, `createEmptyDriveRepository()` is what serves the
# dashboard. Reads return empty collections and every write returns
# `not_configured`, which the UI reports as "your storage provider isn't
# connected yet" — it never pretends an upload, move or delete succeeded.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional explicit endpoint. Leave empty to derive
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com. Set it only when using a
# jurisdiction-specific or custom endpoint.
R2_ENDPOINT=

# Public base URL for reading objects back (custom domain or r2.dev). Used to
# build preview and download URLs. Leave empty to keep previews in their
# metadata-only state.
R2_PUBLIC_BASE_URL=

# Upload limits are code constants, not env vars — see UPLOAD_LIMITS in
# src/lib/drive/types.ts. The multipart threshold must stay in sync with the
# server's presign logic; changing it here would desync the two.

# ---------------------------------------------------------------------------
# Billing (Razorpay)
# ---------------------------------------------------------------------------

# Key ID is the only billing value that could ever reach the browser; the secret
# stays server-side and is used to verify the checkout signature. Both empty
# means no plan can be purchased and the Billing page says so — it never
# simulates a successful payment.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook signing secret from the Razorpay dashboard. Distinct from the key secret:
# it signs the raw webhook body, not a payment id pair.
RAZORPAY_WEBHOOK_SECRET=

# Capability switches. Both default to FALSE, and the server REFUSES an
# international or recurring order while the matching flag is false, rather than
# creating an order Razorpay will reject. Set either to "true" only after
# confirming that capability is actually enabled on the merchant account.
RAZORPAY_INTERNATIONAL_ENABLED=false
RAZORPAY_RECURRING_ENABLED=false

# ---------------------------------------------------------------------------
# Product policy
# ---------------------------------------------------------------------------

# Trash retention in days. Read at runtime by TRASH_RETENTION in
# src/lib/drive/types.ts. 30 is the current proposal and is NOT yet approved as
# a final policy — the Trash UI labels it provisional while that flag is false.
# It is configurable here precisely so the number isn't scattered through copy.
TRASH_RETENTION_DAYS=30

# Days after a subscription lapses during which the account can recover its paid
# allowance without repurchasing. Validated server-side; out-of-range values fall
# back to 90 rather than extending it silently.
RECOVERY_WINDOW_DAYS=90

# ---------------------------------------------------------------------------
# Background jobs (Vercel Cron)
# ---------------------------------------------------------------------------

# Shared secret the cron invocations must present as a bearer token. Vercel sends
# `Authorization: Bearer $CRON_SECRET` automatically when this variable is set.
# With it unset, every /api/cron/* route returns 404 — not 401 — so an
# unconfigured deployment does not advertise which jobs exist.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Malware scanning (integration point only)
# ---------------------------------------------------------------------------

# FALSE means scanning is not active. A file that requires a scan stays
# `quarantined` with its reservation held, and the UI says so. Setting this true
# without a provider wired up would let unscanned bytes become downloadable, so
# it must stay false until src/domain/storage/upload-service.ts has a real
# scanner behind its hook.
MALWARE_SCAN_ENABLED=false

# ---------------------------------------------------------------------------
# Bot protection (Cloudflare Turnstile)
# ---------------------------------------------------------------------------

# Signup, and any flow the risk engine decides needs it. Both values come from
# the Turnstile widget's settings in the Cloudflare dashboard.
#
# With these empty the challenge is skipped — and the server treats "skipped" as
# "no challenge available", never as "challenge passed". The other five layers
# still apply, and /api/health reports the gap rather than hiding it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Anti-abuse
# ---------------------------------------------------------------------------

# Platform markers, read (never written) to decide whether a proxy header can be
# trusted. Vercel sets VERCEL=1; Cloudflare Pages sets CF_PAGES. They are
# documented here because the client-IP resolver refuses to trust
# `x-forwarded-for` without one of them — see src/lib/security/ip.ts.
VERCEL=
CF_PAGES=

# Salt for the IP and device hashes. Without it a hash of an IPv4 address is
# reversible by enumerating 2^32 values, so an unsalted hash is not
# privacy-preserving at all. Any long random string; rotating it resets the
# history the risk engine scores against.
ABUSE_HASH_SALT=

# Optional external disposable-domain feed. Must return
# {"disposable": ["...", ...], "risky": [...]}. With none set, the curated
# baseline in migration 0015 is used and /api/cron/domain-intel validates it
# daily. A feed that is unreachable or implausible is discarded wholesale.
DOMAIN_INTEL_URL=

# ---------------------------------------------------------------------------
# Analytics and Search Console — OPTIONAL, all of it.
#
# Orindle works fully with every variable below unset. Analytics is off until
# both a reporting credential AND a consent mechanism exist; the admin console
# says "not connected" rather than showing sample numbers, and there is no code
# path anywhere that invents traffic.
#
# Collection and reporting are separate systems:
#   NEXT_PUBLIC_*  → browser, public by definition
#   GA_*           → server only, secret. Never carry the NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Master switch. While this is not "true" no analytics script is loaded at all,
# regardless of the measurement id below.
NEXT_PUBLIC_ENABLE_ANALYTICS=

# GA4 measurement id (G-XXXXXXXXXX). Browser-visible by design; it identifies a
# property, not a person, and grants no read access to any data.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Which reporting adapter to use. Only "ga4" is implemented.
ANALYTICS_PROVIDER=

# GA4 numeric property id, for the reporting API.
GA_PROPERTY_ID=

# Service account with Analytics Data API read access. Create it in Google Cloud,
# then add the service-account email as a Viewer on the GA4 property. This is NOT
# the Google sign-in OAuth client: different credential, different scopes.
GA_SERVICE_ACCOUNT_EMAIL=
# PEM private key. Newlines may be literal "\n" escapes.
GA_SERVICE_ACCOUNT_PRIVATE_KEY=

# Whether this build may call the GA4 Data API. Left unset, the admin analytics
# page reports that live reporting is switched off — it does not report zeroes,
# which would read as "no traffic".
GA_LIVE_QUERIES=

# Search Console is a separate source from website analytics and its numbers are
# never combined with GA4 sessions. Requires a verified property plus a service
# account holding access to it.
GSC_SITE_URL=
GSC_SERVICE_ACCOUNT_EMAIL=
GSC_SERVICE_ACCOUNT_PRIVATE_KEY=
